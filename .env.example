# ╔══════════════════════════════════════════════╗
# ║          Nova — Environment Variables         ║
# ╚══════════════════════════════════════════════╝
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.

# ── Required ──
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key          # For Whisper STT + embeddings
TAVILY_API_KEY=your-tavily-api-key

# ── Media (optional — tools degrade gracefully) ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback
YOUTUBE_API_KEY=

# ── Voice Output (optional — falls back to browser SpeechSynthesis) ──
ELEVENLABS_API_KEY=

# ── Database (set automatically by docker-compose) ──
DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5432/nova
DATABASE_URL_SYNC=postgresql://nova:nova@localhost:5432/nova

# ── LLM Configuration ──
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
